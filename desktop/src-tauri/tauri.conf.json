{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-schema-next/refs/heads/main/schema.json",
  "productName": "Podcast Pipeline",
  "version": "0.1.0",
  "identifier": "com.podcastpipeline.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Podcast Pipeline",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8787; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: tauri://localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/podcast-backend/podcast-backend",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": ["binaries/podcast-backend/_internal/**/*"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
