# EditorConfig - https://editorconfig.org
# Helps maintain consistent coding styles across editors and IDEs

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files
[*.py]
indent_size = 4
max_line_length = 100

# YAML files (GitHub Actions, configs)
[*.{yml,yaml}]
indent_size = 2

# TOML files (pyproject.toml, etc.)
[*.toml]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab

# Git config files
[.git*]
indent_size = 2

# Docker files
[Dockerfile*]
indent_size = 4

# Environment files
[.env*]
insert_final_newline = false
