# Podcast Pipeline - Environment Variables
# Copy this file to .env and fill in your keys

# ===================
# REQUIRED
# ===================

# Google Gemini API (for video analysis)
# Uses: gemini-2.5-flash-latest (default) or gemini-3-flash
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===================
# OPTIONAL - Alternative AI Providers
# ===================

# Anthropic Claude (transcript-only analysis; strong structured output)
# Uses: claude-sonnet-4-6 (default), claude-haiku-4-5, claude-opus-4-6
# Get key at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# Moonshot Kimi K2.5 (fallback video analysis)
# Uses: kimi-k2.5 with OpenAI-compatible API
# Get key at: https://platform.moonshot.ai
KIMI_API_KEY=

# OpenAI (fallback for marketing copy)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===================
# OPTIONAL - Research Feature
# ===================

# YouTube Data API (for trend research)
# Get key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Spotify API (for podcast trend research)
# Get credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SerpAPI (for web search trends)
# Get key at: https://serpapi.com/
SERPAPI_KEY=
